# Postgres connection string (Neon, Supabase or any Postgres)
DATABASE_URL=

# GitHub OAuth app (https://github.com/settings/developers)
# Callback URL: https://YOUR_DOMAIN/api/auth/callback/github
GITHUB_ID=
GITHUB_SECRET=

# Optional. Random string (`openssl rand -base64 32`). If unset, one is derived from GITHUB_SECRET.
NEXTAUTH_SECRET=
# Your site URL, e.g. https://kindling.vercel.app
NEXTAUTH_URL=

# Comma-separated GitHub numeric user IDs allowed into /admin
# Find yours at https://api.github.com/users/YOUR_LOGIN (the "id" field)
KINDLING_OPERATOR_GITHUB_IDS=

# Optional. If set, Vercel Cron sends it as a bearer token and other callers are refused.
CRON_SECRET=

# Optional: a GitHub token for repo checks (raises the API rate limit).
# Without it, the OAuth app credentials above are used.
GITHUB_TOKEN=

# Open Collective. Leave KINDLING_OC_SLUG empty for practice mode (no prizes, anyone can vote).
# Set it to your collective's slug (opencollective.com/<slug>) to turn on subscriptions and prizes.
KINDLING_OC_SLUG=
# Optional: a personal token from opencollective.com settings > For developers (raises the rate limit).
OC_PERSONAL_TOKEN=
