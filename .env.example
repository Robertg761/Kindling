# Postgres connection string (Neon, Supabase or any Postgres)
DATABASE_URL=

# GitHub OAuth app (https://github.com/settings/developers)
# Callback URL: https://YOUR_DOMAIN/api/auth/callback/github
GITHUB_ID=
GITHUB_SECRET=

# Random string: `openssl rand -base64 32`
NEXTAUTH_SECRET=
# Your site URL, e.g. https://kindling.vercel.app
NEXTAUTH_URL=

# Comma-separated GitHub numeric user IDs allowed into /admin
# Find yours at https://api.github.com/users/YOUR_LOGIN (the "id" field)
KINDLING_OPERATOR_GITHUB_IDS=

# Random string; Vercel Cron sends it as a bearer token
CRON_SECRET=

# Optional: a GitHub token for repo checks (raises the API rate limit).
# Without it, the OAuth app credentials above are used.
GITHUB_TOKEN=
